# ─────────────────────────────────────────────────────────────────────────────
# Twilio dual-carrier voice support — environment variables
# Copy to .env (or the server's real env file) and fill in real values.
# All phone numbers MUST be E.164 (e.g. +2348012345678).
# ─────────────────────────────────────────────────────────────────────────────

# Twilio account credentials (Console → API keys & tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Standard API Key + Secret created in the Twilio Console
# (used to mint short-lived Access Tokens for the Voice JS SDK)
TWILIO_API_KEY=
TWILIO_API_SECRET=

# TwiML App SID — the app whose Voice URL is https://YOUR_PUBLIC_API_DOMAIN/voice/incoming
TWILIO_TWIML_APP_SID=

# The exact public HTTPS base URL that Twilio (and Termii SIP) reach the API on,
# WITHOUT a trailing slash, e.g. https://api.rentalhub.com.ng
# MUST match the URL configured on the Twilio number/TwiML App webhook exactly,
# because Twilio signs requests over the full URL.
TWILIO_WEBHOOK_BASE_URL=

# Primary destinations per carrier (E.164)
NIGERIA_NUMBER=+2348012345678
INTL_NUMBER=+12025550123
SALES_BACKUP_NUMBER=+2348098765432

# Optional Nigerian toll-free number (E.164). When set, calls to it are
# classified as toll_free and shown as "Toll-free call" to agents.
TOLL_FREE_NUMBER=

# Optional caller ID shown to outbound-call recipients (E.164).
# Defaults to NIGERIA_NUMBER when unset. Must be a number you own/verified.
OUTBOUND_CALLER_ID=

# Optional rate-limit tuning for GET /voice/token (defaults shown)
VOICE_TOKEN_WINDOW_MS=600000
VOICE_TOKEN_MAX=30

# ── Support queue & hold experience ──────────────────────────────────────────
# Callers who press 1 are enqueued and hear a wait loop (announcement →
# optional ad slot → optional hold music) until an agent on the line picks
# them up. Agents join the line automatically from the Voice Desk.
VOICE_QUEUE_NAME=support
VOICE_QUEUE_ANNOUNCEMENT=All agents are currently helping other callers. Please hold.
VOICE_HOLD_MUSIC_URL=

# ── Audio ad slots on hold ───────────────────────────────────────────────────
# Ads come from the platform's ad-spaces DB (media_type=audio,
# placement=voice_hold, managed in the Super Admin → Ad Spaces tab). Impressions
# are counted once per (ad, call). VOICE_AD_AUDIO_URLS below is only the
# fallback when the DB has no audio ads or is unreachable.
VOICE_ADS_ENABLED=false
VOICE_AD_AUDIO_URLS=

# ── Department escalation (agent-initiated) ──────────────────────────────────
# Format: "name:target,name:target" where target is an E.164 number or a
# Twilio Client identity (write "client:<identity>", e.g. legal:client:legal_1).
# The Voice Desk shows these names during a call; escalating transfers the
# caller to the target.
VOICE_ESCALATION_DEPARTMENTS=finance:+2348012345678,legal:client:legal_1

# ── After-hours handling (optional) ─────────────────────────────────────────
# When both START and END are set, calls outside the window (in the configured
# timezone, excluding holidays) get the after-hours IVR with a callback option.
# Format: HH:MM (24h). Holidays: comma-separated MM-DD dates in the same tz.
VOICE_SUPPORT_HOURS_START=09:00
VOICE_SUPPORT_HOURS_END=18:00
VOICE_SUPPORT_TIMEZONE=Africa/Lagos
VOICE_HOLIDAY_DAYS=01-01,12-25

# ── QA / compliance recording (optional, default off) ───────────────────────
# When enabled, every connected call is recorded from answer and a consent
# message is played before dialing. Recording URLs land in voice_call_events.
VOICE_RECORD_CALLS=false

# Substring used to detect the Termii SIP trunk leg in req.body.To
# (leave as sip: for standard SIP trunks)
NIGERIA_SIP_TRUNK_MATCH=sip:
